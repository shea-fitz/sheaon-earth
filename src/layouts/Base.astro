---
import '../styles/global.css';

const { title = 'shea on air', background } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="shea on air" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <div
      class:list={['page-bg', background && `page-bg-${background}`]}
      aria-hidden="true"
    ></div>

    <header>
      <nav aria-label="Main" class="nav-container">
        <a href="/">home</a>
        <a href="/releases">releases</a>
        <a href="/writing">writing</a>
        <a href="/transmissions">transmissions</a>
        <a href="/a-complete-history">a complete history</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  .nav-container {
    display: flex;
    gap: 50px;
    position: fixed;
    top: 1.75rem;
    right: 1rem;
  }

  @media screen and (max-width: 768px) {
  .nav-container {
    flex-direction: column;
    justify-content: right;
    align-items: right;
    gap: 12px;
  }
}


</style>
