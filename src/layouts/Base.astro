---
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';

const {
  title = 'shea on air',
  background,
  flushTop = false,
  backgroundOverlay = false,
  flipBackground = false,
} = Astro.props;

const bgImages = ['bg1', 'bg2', 'bg3', 'bg4', 'bg5'];
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="shea on air" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" data-astro-transition-persist="favicon" />
    <link
      rel="preload"
      href="/fonts/batangche/BatangChe-Regular.ttf"
      as="font"
      type="font/ttf"
      crossorigin
      data-astro-transition-persist="font-batangche"
    />
    {
      bgImages.map((bg) => (
        <link
          rel="preload"
          href={`/images/bg/${bg}.webp`}
          as="image"
          data-astro-transition-persist={`bg-preload-${bg}`}
        />
      ))
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" data-astro-transition-persist="fonts-google" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin data-astro-transition-persist="fonts-gstatic" />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&display=swap"
      rel="stylesheet"
      data-astro-transition-persist="font-dm-mono"
    />
    <title>{title}</title>
    <ViewTransitions />
  </head>
  <body data-background={background}>
    <div class="page-bg-layers" aria-hidden="true">
      <div
        id="page-bg-primary"
        class:list={['page-bg', 'page-bg-layer', 'is-visible', background && `page-bg-${background}`, flipBackground && 'is-flipped']}
      ></div>
      <div id="page-bg-secondary" class="page-bg page-bg-layer"></div>
    </div>

    <div class="site-shell" data-nav-open="false">
      <SiteNav />
      <div
        class:list={['site-main', 'is-awaiting', { 'site-main-flush-top': flushTop, 'site-main-has-overlay': backgroundOverlay }]}
        data-background={background}
        data-background-flip={flipBackground ? 'true' : undefined}
      >
        {backgroundOverlay && <div class="site-main-overlay" aria-hidden="true"></div>}
        <main>
          <slot />
        </main>
      </div>
    </div>

    <script>
      import '../scripts/page-navigation.ts';
      import '../scripts/smooth-scroll.ts';
    </script>
  </body>
</html>
