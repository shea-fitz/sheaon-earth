---
import { getCollection } from 'astro:content';
import { navItems } from '../data/navigation.js';

const currentPath = Astro.url.pathname;

const notesEntries = (await getCollection('notes')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const tree = navItems.map((item) => {
  if (item.dynamicChildren === 'notes') {
    return {
      ...item,
      children: notesEntries.map((entry) => ({
        href: `/notes/${entry.slug}/`,
        label: entry.data.title,
      })),
    };
  }
  return item;
});

const desktopItems = tree.filter((item) => item.href !== '/');

function normalizePath(path) {
  if (path !== '/' && path.endsWith('/')) return path.slice(0, -1);
  return path;
}

const normalizedCurrent = normalizePath(currentPath);

function isLinkActive(href, hasChildren = false) {
  const normalized = normalizePath(href);
  if (normalizedCurrent === normalized) return true;
  if (hasChildren && normalizedCurrent.startsWith(`${normalized}/`)) return true;
  return false;
}

const isHomeActive = normalizedCurrent === '/';
---

<div class="site-nav">
  <nav class="desktop-nav" aria-label="Main">
    <a
      href="/"
      class:list={['nav-home', { active: isHomeActive }]}
      aria-label="home"
      aria-current={isHomeActive ? 'page' : undefined}
    >
      ꩜
    </a>
    <ul class="desktop-nav-links">
      {
        desktopItems.map((item) => {
          const hasChildren = item.children && item.children.length > 0;
          const active = isLinkActive(item.href, hasChildren);
          return (
            <li>
              <a
                href={item.href}
                class:list={[{ active }]}
                aria-current={active ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>

  <div class="mobile-nav">
    <button
      type="button"
      class="menu-trigger"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      menu
    </button>

    <aside class="nav-drawer" id="site-nav" aria-hidden="true">
      <button type="button" class="nav-close" aria-label="Close menu">
        &lt;&lt;
      </button>

      <nav aria-label="Main">
        <ul class="nav-tree">
          {
            tree.map((item) => {
              const hasChildren = item.children && item.children.length > 0;
              const parentActive = isLinkActive(item.href, hasChildren);
              return (
                <li class:list={[{ 'has-children': hasChildren }]}>
                  <a
                    href={item.href}
                    class:list={[{ active: parentActive }]}
                    aria-current={
                      normalizedCurrent === normalizePath(item.href)
                        ? 'page'
                        : undefined
                    }
                  >
                    {item.label}
                  </a>
                  {hasChildren && (
                    <ul>
                      {item.children.map((child) => {
                        const childActive = isLinkActive(child.href);
                        return (
                          <li>
                            <a
                              href={child.href}
                              class:list={[{ active: childActive }]}
                              aria-current={childActive ? 'page' : undefined}
                            >
                              {child.label}
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  )}
                </li>
              );
            })
          }
        </ul>
      </nav>
    </aside>
  </div>
</div>

<style>
  .site-nav {
    position: relative;
    z-index: 100;
  }

  .desktop-nav {
    display: none;
    background: var(--color-surface);
    backdrop-filter: blur(3px);
  }

  .mobile-nav {
    display: block;
  }

  .desktop-nav a {
    color: inherit;
    text-decoration: none;
    font-family: BatangChe;
    font-size: 1rem;
    line-height: var(--line-height-normal);
    text-transform: uppercase;
  }

  .desktop-nav a:hover,
  .desktop-nav a:focus-visible {
    color: var(--color-accent);
    outline: none;
  }

  .desktop-nav a.active {
    color: var(--color-accent);
  }

  .nav-home {
    font-size: var(--font-size-base);
    line-height: 1;
    text-transform: none;
  }

  .menu-trigger,
  .nav-close {
    font: inherit;
    font-size: var(--font-size-sm);
    color: inherit;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.75rem 1rem;
    text-align: left;
    text-transform: lowercase;
  }

  .menu-trigger:hover,
  .menu-trigger:focus-visible,
  .nav-close:hover,
  .nav-close:focus-visible {
    color: var(--color-accent);
    outline: none;
  }

  .nav-drawer {
    overflow: hidden;
    background: transparent;
  }

  .nav-close {
    display: none;
    padding-bottom: 0.5rem;
  }

  .nav-tree {
    list-style: none;
    margin: 0;
    padding: 0 1rem 1.5rem 1.5rem;
  }

  .nav-tree ul {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1.25rem;
    position: relative;
  }

  .nav-tree ul::before {
    content: '';
    position: absolute;
    left: 0.35rem;
    top: 0;
    bottom: 0.5rem;
    width: 1px;
    background: color-mix(in srgb, var(--color-text) 30%, transparent);
  }

  .nav-tree li {
    position: relative;
    padding: 0.2rem 0;
  }

  .nav-tree > li::before {
    content: '';
    position: absolute;
    left: -0.85rem;
    top: 0.7em;
    width: 0.65rem;
    height: 1px;
    background: color-mix(in srgb, var(--color-text) 30%, transparent);
  }

  .nav-tree ul li::before {
    content: '';
    position: absolute;
    left: -0.9rem;
    top: 0.7em;
    width: 0.65rem;
    height: 1px;
    background: color-mix(in srgb, var(--color-text) 30%, transparent);
  }

  .nav-tree > li:first-child::after {
    content: '';
    position: absolute;
    left: -0.85rem;
    top: 0;
    height: 0.7em;
    width: 1px;
    background: color-mix(in srgb, var(--color-text) 30%, transparent);
  }

  .nav-tree > li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: -0.85rem;
    top: 0;
    bottom: 0;
    width: 1px;
    background: color-mix(in srgb, var(--color-text) 30%, transparent);
  }

  .nav-tree > li:last-child:not(:only-child)::after {
    bottom: auto;
    height: 0.7em;
  }

  .nav-tree a {
    color: inherit;
    text-decoration: none;
    font-size: var(--font-size-sm);
    line-height: var(--line-height-normal);
  }

  .nav-tree a:hover,
  .nav-tree a:focus-visible {
    color: var(--color-accent);
    outline: none;
  }

  .nav-tree a.active {
    color: var(--color-accent);
  }

  /* Desktop: fixed top bar */
  @media (min-width: 48rem) {
    .desktop-nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      min-height: var(--header-height);
      padding: 0 2rem;
      border-bottom: 1px solid color-mix(in srgb, var(--color-text) 15%, transparent);
    }

    .desktop-nav-links {
      display: flex;
      align-items: center;
      gap: 2rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .mobile-nav {
      display: none;
    }
  }

  /* Mobile: fixed bottom bar; open drawer overlays above */
  @media (max-width: 47.99rem) {
    .mobile-nav {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
    }

    .menu-trigger {
      width: 100%;
      min-height: var(--header-height);
      display: flex;
      align-items: center;
      border-top: 1px solid color-mix(in srgb, var(--color-text) 15%, transparent);
    }

    .nav-drawer {
      position: fixed;
      bottom: var(--header-height);
      left: 0;
      right: 0;
      max-height: 0;
      overflow: hidden;
      border-top: 1px solid color-mix(in srgb, var(--color-text) 15%, transparent);
      visibility: hidden;
      pointer-events: none;
      transition:
        max-height var(--nav-transition),
        visibility var(--nav-transition);
    }

    :global(.site-shell[data-nav-open='true']) .nav-drawer {
      max-height: var(--nav-drawer-max);
      visibility: visible;
      pointer-events: auto;
    }

    :global(.site-shell[data-nav-open='true']) .nav-close {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-drawer {
      transition: none;
    }
  }
</style>

<script>
  const shell = document.querySelector('.site-shell');
  const trigger = document.querySelector('.menu-trigger');
  const closeBtn = document.querySelector('.nav-close');
  const drawer = document.getElementById('site-nav');

  function setOpen(open) {
    shell?.setAttribute('data-nav-open', open ? 'true' : 'false');
    trigger?.setAttribute('aria-expanded', String(open));
    drawer?.setAttribute('aria-hidden', String(!open));
    if (!open) trigger?.focus();
  }

  trigger?.addEventListener('click', () => {
    const isOpen = shell?.getAttribute('data-nav-open') === 'true';
    setOpen(!isOpen);
  });

  closeBtn?.addEventListener('click', () => setOpen(false));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && shell?.getAttribute('data-nav-open') === 'true') {
      setOpen(false);
    }
  });

  function closeNav() {
    setOpen(false);
  }

  drawer?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeNav);
  });

  document.addEventListener('astro:before-preparation', closeNav);
</script>
