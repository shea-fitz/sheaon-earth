---
import { releases } from '../data/releases.js';
import { releaseNotesTag, slugifyTag } from '../utils/tags.js';

interface Props {
  showNotesLinks?: boolean;
  showCredits?: boolean;
  showThemes?: boolean;
}

const { showNotesLinks = false, showCredits = false, showThemes = false } = Astro.props;

const sortedReleases = [...releases].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);

function releaseYear(date) {
  return new Date(date).getFullYear();
}

function formatReleaseType(type) {
  if (!type) return '';
  if (type === type.toUpperCase()) return type;
  return type.charAt(0).toUpperCase() + type.slice(1);
}

function parseBandcampEmbed(embed) {
  const value = embed?.trim();
  if (!value) return null;
  if (value.startsWith('https://bandcamp.com/EmbeddedPlayer')) return value;

  const match = value.match(/src=["']([^"']+)["']/i);
  return match?.[1] ?? null;
}
---

{sortedReleases.length === 0 ? (
  <p class="releases-empty">No releases yet.</p>
) : (
  <ul class="release-list">
    {sortedReleases.map((release) => {
      const embedSrc = parseBandcampEmbed(release.embed);

      return (
      <li class="release-item">
        {embedSrc && (
          <div class="release-embed-wrapper">
            <iframe
              class="release-embed"
              src={embedSrc}
              title={`${release.title} — Bandcamp player`}
              width="350"
              height="350"
              loading="lazy"
              allow="autoplay"
              seamless
            />
          </div>
        )}
        <div class="release-meta">
          <p class="release-heading">
            <span class="release-title">{release.title}</span>
            <span aria-hidden="true"> – </span>
            <span class="release-type">{formatReleaseType(release.type)}</span>
          </p>
          <time class="release-year" datetime={release.date}>
            {releaseYear(release.date)}
          </time>
          {showThemes && release.themes?.trim() && (
            <p class="release-themes">themes: {release.themes}</p>
          )}
          {showCredits && release.credits?.length > 0 && (
            <div class="release-credits">
              <p class="release-credits-label">credits</p>
              <ul class="release-credits-list">
                {release.credits.map(({ role, name, url }) => (
                  <li>
                    <span class="release-credit-role">{role}</span>:{' '}
                    {url ? (
                      <a
                        class="release-credit-link"
                        href={url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {name}
                      </a>
                    ) : (
                      name
                    )}
                  </li>
                ))}
              </ul>
            </div>
          )}
          {showNotesLinks && (
            <a
              class="release-notes-link"
              href={`/notes/tags/${slugifyTag(releaseNotesTag(release))}/`}
            >
              notes<span class="release-notes-arrow" aria-hidden="true"> ↝</span>
            </a>
          )}
        </div>
      </li>
      );
    })}
  </ul>
)}

<style>
  .releases-empty {
    margin: 0;
  }

  .release-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--release-cols), minmax(0, 1fr));
    gap: var(--release-gap);
    width: 100%;
  }

  .release-item {
    margin: 0;
    min-width: 0;
  }

  .release-embed-wrapper {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--color-surface, #e8e8e8);
    border: .5px solid var(--color-accent);
  }

  .release-embed {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .release-meta {
    display: flex;
    flex-direction: column;
    gap: .25rem;
    line-height: 1.4;
    background-color: var(--color-surface);
    border-bottom: .5px solid var(--color-border);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(15px);
    padding: .75rem;
  }

  .release-heading {
    margin: 0;
    font-size: 1.5rem;
  }

  .release-title {
    font-family: BatangChe;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .release-year {
    font-variant-numeric: tabular-nums;
    font-size: 0.875rem;
  }

  .release-type {
    font-style: normal;
    font-family: BatangChe;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .release-themes {
    margin-top: 1rem;
    font-size: .875rem;
    font-style: italic;
    line-height: 1.5;
  }

  .release-credits {
    margin-top: 1rem;
  }

  .release-credits-label {
    margin: 0 0 0.5rem;
    font-size: 0.875rem;
    font-family: BatangChe;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .release-credits-list {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.875rem;
    line-height: 1.25;
  }

  .release-credits-list li + li {
    margin-top: 0.25rem;
  }

  .release-credit-role {
    font-family: var(--font-family-sans);
    color: var(--color-text);
  }

  .release-credit-link {
    color: inherit;
    text-decoration: none;
  }

  .release-credit-link:hover,
  .release-credit-link:focus-visible {
    filter: blur(2px);
  }

  .release-notes-link {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-accent);
    text-decoration: none;
    width: fit-content;
    transition: opacity 0.2s ease;
    padding-top: 1rem;
  }

  .release-notes-arrow {
    display: inline-block;
    color: var(--color-accent);
    line-height: 0;
    vertical-align: -0.12em;
    margin-left: 0.1em;
    transform: scale(1.85);
    transform-origin: left center;
  }

  .release-notes-link:hover,
  .release-notes-link:focus-visible {
    opacity: 0.75;
    outline: none;
  }

  @media (max-width: 428px){
    .release-list {
      gap: 2rem;
    }
  }
</style>
