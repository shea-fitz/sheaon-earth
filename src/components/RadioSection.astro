---
import { radioMixes } from '../data/radio-mixes.js';

function soundcloudPlayerSrc(trackId, color) {
  const trackUrl = `https://api.soundcloud.com/tracks/soundcloud:tracks:${trackId}`;
  return `https://w.soundcloud.com/player/?url=${encodeURIComponent(trackUrl)}&color=${encodeURIComponent(color)}&inverse=false&auto_play=false&show_user=false`;
}

const dated = radioMixes
  .filter((mix) => mix.date)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const undated = radioMixes.filter((mix) => !mix.date);

const mixes = [...dated, ...undated];
---

<ul class="radio-list">
  {mixes.map((mix) => (
    <li class="radio-item">
      <iframe
        class="radio-player"
        width="100%"
        height="20"
        scrolling="no"
        frameborder="no"
        allow="autoplay; encrypted-media"
        src={soundcloudPlayerSrc(mix.trackId, mix.color)}
        title={mix.title}
        data-track-id={mix.trackId}
        {...(mix.artwork ? { 'data-artwork': mix.artwork } : {})}
      />
      {mix.tracklist?.length > 0 && (
        <details class="radio-tracklist">
          <summary class="radio-tracklist-toggle">Tracklist ↯</summary>
          <ul class="radio-tracklist-items">
            {mix.tracklist.map((track) => (
              <li>{track}</li>
            ))}
          </ul>
        </details>
      )}
    </li>
  ))}
</ul>

<div class="radio-artwork-disc" aria-hidden="true" hidden>
  <div class="radio-artwork-disc__inner"></div>
</div>

<script>
  import '../scripts/radio-artwork-disc.ts';
</script>

<style>
  .radio-list {
    display: flex;
    flex-direction: column;
    list-style: none;
    gap: 2rem;
    margin: 0;
    padding: 0;
  }

  .radio-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    color: var(--color-bg);
    margin: 0 -2rem;
    padding: 0 2rem;
  }

  .radio-player {
    display: block;
    border: 0;
  }

  .radio-tracklist-toggle {
    font-family: batangche;
    text-transform: uppercase;
    font-size: .875rem;
    color: var(--color-accent);
    cursor: pointer;
    list-style: none;
    margin-left: 2rem;
    mix-blend-mode: multiply;
  }

  .radio-tracklist-toggle::-webkit-details-marker {
    display: none;
  }

  .radio-tracklist-toggle:hover{
    filter: blur(2px);
  }

  .radio-tracklist-items {
    list-style: none;
    margin: 0.5rem 0 0 2rem;
    padding: 0;
    font-family: var(--font-family-sans);
    font-size: .75rem;
    color: var(--color-bg);
  }

  details[open] .radio-tracklist-items {
    animation: radio-tracklist-reveal 1.4s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes radio-tracklist-reveal {
    from {
      opacity: 0;
      filter: blur(3px);
    }

    to {
      opacity: 1;
      filter: blur(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    details[open] .radio-tracklist-items {
      animation: none;
      opacity: 1;
      filter: none;
    }
  }

  .radio-artwork-disc {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 10;
    width: 250px;
    height: 250px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.8s ease;
  }

  .radio-artwork-disc.is-visible {
    opacity: 1;
  }

  .radio-artwork-disc__inner {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: .5px solid var(--color-accent);
    background-size: cover;
    background-position: center;
    box-shadow:
      0 0 48px 16px color-mix(in srgb, var(--color-accent) 25%, transparent),
      0 0 96px 32px color-mix(in srgb, var(--color-accent) 5%, transparent);
  }

  .radio-artwork-disc.is-spinning .radio-artwork-disc__inner {
    animation: radio-disc-spin 24s linear infinite;
  }

  @keyframes radio-disc-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 768px) {
    .radio-artwork-disc {
      bottom: 1.25rem;
      right: 1.25rem;
      width: 150px;
      height: 150px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .radio-artwork-disc.is-spinning .radio-artwork-disc__inner {
      animation: none;
    }
  }
</style>
