---
import { radioMixes } from '../data/radio-mixes.js';

function soundcloudPlayerSrc(trackId, color) {
  const trackUrl = `https://api.soundcloud.com/tracks/soundcloud:tracks:${trackId}`;
  return `https://w.soundcloud.com/player/?url=${encodeURIComponent(trackUrl)}&color=${encodeURIComponent(color)}&inverse=false&auto_play=false&show_user=false`;
}

const dated = radioMixes
  .filter((mix) => mix.date)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const undated = radioMixes.filter((mix) => !mix.date);

const mixes = [...dated, ...undated];
---

<div class="radio-section">
<ul class="radio-list">
  {mixes.map((mix, index) => (
    <li class="radio-item">
      <iframe
        class="radio-player"
        width="100%"
        height="20"
        scrolling="no"
        frameborder="no"
        allow="autoplay; encrypted-media"
        loading="eager"
        src={soundcloudPlayerSrc(mix.trackId, mix.color)}
        title={mix.title}
        data-track-id={mix.trackId}
        data-mix-index={index}
        {...(mix.artwork ? { 'data-artwork': mix.artwork } : {})}
      />
      {mix.tracklist?.length > 0 && (
        <details class="radio-tracklist">
          <summary class="radio-tracklist-toggle">Tracklist ↯</summary>
          <ul class="radio-tracklist-items">
            {mix.tracklist.map((track) => (
              <li>{track}</li>
            ))}
          </ul>
        </details>
      )}
    </li>
  ))}
</ul>

<div class="radio-jukebox" aria-hidden="true" hidden>
  <button type="button" class="radio-jukebox__orb" data-offset="-2" hidden aria-label="Play mix">
    <span class="radio-jukebox__orb-label"></span>
    <span class="radio-jukebox__orb-inner"></span>
  </button>
  <button type="button" class="radio-jukebox__orb" data-offset="-1" hidden aria-label="Play mix">
    <span class="radio-jukebox__orb-label"></span>
    <span class="radio-jukebox__orb-inner"></span>
  </button>
  <button type="button" class="radio-jukebox__orb is-center" data-offset="0" hidden aria-label="Pause mix">
    <span class="radio-jukebox__orb-label"></span>
    <span class="radio-jukebox__orb-inner"></span>
  </button>
  <button type="button" class="radio-jukebox__orb" data-offset="1" hidden aria-label="Play mix">
    <span class="radio-jukebox__orb-label"></span>
    <span class="radio-jukebox__orb-inner"></span>
  </button>
  <button type="button" class="radio-jukebox__orb" data-offset="2" hidden aria-label="Play mix">
    <span class="radio-jukebox__orb-label"></span>
    <span class="radio-jukebox__orb-inner"></span>
  </button>
</div>

</div>

<script>
  import '../scripts/radio-artwork-disc.ts';
</script>

<style>
  .radio-section {
    --radio-jukebox-bottom: 2rem;
    --radio-jukebox-orb-size: 140px;
  }

  .radio-list {
    display: flex;
    flex-direction: column;
    list-style: none;
    gap: 2rem;
    margin: 0;
    padding: 0 0 1rem;
  }

  .radio-section:has(.radio-jukebox.is-visible) .radio-list {
    padding-bottom: calc(
      var(--radio-jukebox-bottom) + var(--radio-jukebox-orb-size) + 1rem
    );
  }

  .radio-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    color: var(--color-bg);
    margin: 0 -2rem;
    padding: 0 2rem;
  }

  .radio-player {
    display: block;
    border: 0;
  }

  .radio-tracklist-toggle {
    font-family: batangche;
    text-transform: uppercase;
    font-size: .875rem;
    color: var(--color-accent);
    cursor: pointer;
    list-style: none;
    margin-left: 2rem;
    mix-blend-mode: multiply;
  }

  .radio-tracklist-toggle::-webkit-details-marker {
    display: none;
  }

  .radio-tracklist-toggle:hover{
    filter: blur(2px);
  }

  .radio-tracklist-items {
    list-style: none;
    margin: 0.5rem 0 0 2rem;
    padding: 0;
    font-family: var(--font-family-sans);
    font-size: .75rem;
    color: var(--color-bg);
  }

  details[open] .radio-tracklist-items {
    animation: radio-tracklist-reveal 1.4s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes radio-tracklist-reveal {
    from {
      opacity: 0;
      filter: blur(3px);
    }

    to {
      opacity: 1;
      filter: blur(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    details[open] .radio-tracklist-items {
      animation: none;
      opacity: 1;
      filter: none;
    }
  }

  .radio-jukebox {
    position: fixed;
    bottom: var(--radio-jukebox-bottom, 2rem);
    left: 50%;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    pointer-events: none;
    opacity: 0;
    transform: translateX(-50%);
    transition: opacity 0.8s ease;
  }

  .radio-jukebox.is-visible {
    opacity: 1;
  }

  .radio-jukebox.is-visible .radio-jukebox__orb:not([hidden]) {
    pointer-events: auto;
  }

  .radio-jukebox__orb {
    position: relative;
    flex-shrink: 0;
    display: block;
    overflow: visible;
    border-radius: 50%;
    border: 0;
    padding: 0;
    background: none;
    appearance: none;
    line-height: 0;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .radio-jukebox__orb.is-side {
    z-index: 2;
    cursor: pointer;
  }

  .radio-jukebox__orb.is-center {
    z-index: 1;
    cursor: pointer;
  }

  .radio-jukebox__orb.is-side::before {
    content: '';
    position: absolute;
    inset: -14px;
    z-index: 1;
  }

  .radio-jukebox__orb-label {
    position: absolute;
    bottom: calc(100% + 0.625rem);
    left: 50%;
    z-index: 1;
    max-width: 12rem;
    padding: 0;
    font-family: batangche, sans-serif;
    font-size: 0.75rem;
    line-height: 1.2;
    text-align: center;
    text-transform: uppercase;
    color: var(--color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    opacity: 0;
    pointer-events: none;
    transform: translateX(-50%) translateY(4px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .radio-jukebox__orb:hover .radio-jukebox__orb-label,
  .radio-jukebox__orb:focus-visible .radio-jukebox__orb-label {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .radio-jukebox__orb.is-side:hover .radio-jukebox__orb-inner,
  .radio-jukebox__orb.is-center:hover .radio-jukebox__orb-inner {
    filter: brightness(1.08);
  }

  .radio-jukebox__orb-inner {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 50%;
    border: 0.5px solid var(--color-accent);
    background-size: cover;
    background-position: center;
    box-shadow:
      0 0 48px 16px color-mix(in srgb, var(--color-accent) 25%, transparent),
      0 0 96px 32px color-mix(in srgb, var(--color-accent) 5%, transparent);
  }

  .radio-jukebox__orb[data-offset='-2'],
  .radio-jukebox__orb[data-offset='2'] {
    width: 56px;
    height: 56px;
  }

  .radio-jukebox__orb[data-offset='-1'],
  .radio-jukebox__orb[data-offset='1'] {
    width: 88px;
    height: 88px;
  }

  .radio-jukebox__orb.is-center {
    width: var(--radio-jukebox-orb-size, 140px);
    height: var(--radio-jukebox-orb-size, 140px);
  }

  .radio-jukebox__orb.is-center.is-floating {
    animation: radio-orb-float 4.5s ease-in-out infinite;
  }

  @keyframes radio-orb-float {
    0%,
    100% {
      transform: translateY(0) scale(1);
    }

    50% {
      transform: translateY(-14px) scale(1.03);
    }
  }

  @media (max-width: 768px) {
    .radio-section {
      --radio-jukebox-bottom: max(1.25rem, env(safe-area-inset-bottom));
      --radio-jukebox-orb-size: 100px;
    }

    .radio-jukebox {
      bottom: var(--radio-jukebox-bottom);
      gap: 0.75rem;
    }

    .radio-jukebox__orb[data-offset='-2'],
    .radio-jukebox__orb[data-offset='2'] {
      width: 40px;
      height: 40px;
    }

    .radio-jukebox__orb[data-offset='-1'],
    .radio-jukebox__orb[data-offset='1'] {
      width: 64px;
      height: 64px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .radio-jukebox__orb.is-center.is-floating {
      animation: none;
    }
  }
</style>
