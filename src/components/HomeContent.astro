---
import ReleasesSection from './ReleasesSection.astro';

interface Props {
  showReleases?: boolean;
}

const { showReleases = false } = Astro.props;
---

<div class="home-content">
  <div class="info">
    <p>shea on air is the solo flute project of flutist, drummer, producer, and designer Shea Fitzpatrick.</p>
    <div class="stream-list">
      <a class="stream-link" href="https://sheaonair.bandcamp.com/" target="_blank">
        <img src="/images/icons/bandcamp.svg" alt="Bandcamp" />
      </a>
      <a class="stream-link" href="https://open.spotify.com/artist/26Ihw2k2n71sPltSmJiH5J?si=TEYJ8VQ5QbikWTFt7k7XQA" target="_blank">
        <img src="/images/icons/spotify.svg" alt="Spotify" />
      </a>
      <a class="stream-link" href="https://music.apple.com/us/artist/shea-on-air/1828082723" target="_blank">
        <img src="/images/icons/apple-music.svg" alt="Apple Music" />
      </a>
      <a class="stream-link" href="https://www.subvert.fm/shea-on-air" target="_blank">
        <img src="/images/icons/subvert.svg" alt="Subvert" />
      </a>
      <a class="stream-link" href="https://www.youtube.com/@sheaonairr" target="_blank">
        <img src="/images/icons/youtube.svg" alt="YouTube" />
      </a>
    </div>
    <div class="contact-list">
      <div class="contact-link"><a href="https://www.instagram.com/sheafitz/" target="_blank">@sheafitz</a></div>
      <div class="contact-link"><a href="mailto:sheaonair@gmail.com">sheaonair@gmail.com</a></div>
      <div class="contact-link"><a href="https://www.are.na/shea/" target="_blank">are.na/shea</a></div>
    </div>
  </div>

  <div class:list={['releases-panel', showReleases && 'is-visible']} id="releases">
    <ReleasesSection />
  </div>
</div>

<style>
  .home-content {
    position: absolute;
    top: 1rem;
  }

  .info {
    max-width: 25rem;
  }

  .stream-list {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 2rem 0;
  }

  .stream-link {
    color: inherit;
    text-decoration: none;
    line-height: 0;
  }

  .stream-link img {
    display: block;
    width: 32px;
    height: 32px;
  }

  .stream-link:hover,
  .stream-link:focus-visible {
    opacity: 0.75;
  }

  .contact-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .contact-link > a {
    color: var(--text);
    text-decoration: none;
  }

  .releases-panel {
    display: none;
    margin-top: 2.5rem;
    width: min(calc(100vw - 4rem), 72rem);
  }

  .releases-panel.is-visible {
    display: block;
  }
</style>
