---
import ReleasesSection from './ReleasesSection.astro';
import ShowsAndFeaturesSection from './ShowsAndFeaturesSection.astro';
import InfluencesSection from './InfluencesSection.astro';
import SectionImagePlaceholder from './SectionImagePlaceholder.astro';
import { homeLayoutImages } from '../data/home-layout-images.js';
import '../styles/release-grid.css';
---

<div class="home-content release-grid-context">
  <section class="home-section info">
    <p class="bio"><a href="https://www.are.na/block/31038293" taget="_blank">[a porous field]</a>
    </p>
    <div class="stream-list">
      <a class="stream-link" href="https://sheaonair.bandcamp.com/" target="_blank">
        <img src="/images/icons/bandcamp.svg" alt="Bandcamp" />
      </a>
      <a class="stream-link" href="https://open.spotify.com/artist/26Ihw2k2n71sPltSmJiH5J?si=TEYJ8VQ5QbikWTFt7k7XQA" target="_blank">
        <img src="/images/icons/spotify.svg" alt="Spotify" />
      </a>
      <a class="stream-link" href="https://music.apple.com/us/artist/shea-on-air/1828082723" target="_blank">
        <img src="/images/icons/apple-music.svg" alt="Apple Music" />
      </a>
      <a class="stream-link" href="https://www.subvert.fm/shea-on-air" target="_blank">
        <img src="/images/icons/subvert.svg" alt="Subvert" />
      </a>
      <a class="stream-link" href="https://www.youtube.com/@sheaonair" target="_blank">
        <img src="/images/icons/youtube.svg" alt="YouTube" />
      </a>
    </div>
    <div class="contact-list">
      <div class="contact-link ig"><a href="https://www.instagram.com/sheafitz/" target="_blank">@sheafitz</a></div>
      <div class="contact-link email"><a href="mailto:sheaonair@gmail.com">sheaonair@gmail.com</a></div>
      <div class="contact-link arena"><a href="https://www.are.na/shea/" target="_blank">are.na/shea</a></div>
    </div>
  </section>

  <div class="home-spacer" aria-hidden="true"></div>

  <section class="home-section releases-section" id="releases">
    <div class="home-section-row home-section-row--releases">
      <h2 class="section-heading">Releases</h2>
      <div class="releases-section-content">
        <ReleasesSection showTrailingPlaceholder />
      </div>
    </div>
  </section>

  <section class="home-section shows-section">
    <div class="home-section-row home-section-row--shows">
      <h2 class="section-heading">Shows and features</h2>
      <SectionImagePlaceholder
        src={homeLayoutImages.showsLeading}
        alt=""
        class="home-section-aside"
        tilt="right"
      />
      <div class="home-section-row__span-3-end">
        <ShowsAndFeaturesSection />
      </div>
    </div>
  </section>

  <section class="home-section influences-section">
    <h2 class="section-heading">Influences</h2>
    <div class="home-section-row">
      <div class="home-section-row__span-3-start influences-layout">
        <div class="playlist-embed">
          <iframe data-testid="embed-iframe" style="border-radius:24px" src="https://open.spotify.com/embed/playlist/7ImqtO0F0s524tzNZqn8ZR?utm_source=generator" height="152" frameBorder="0" allowfullscreen="" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>
        </div>
        <InfluencesSection />
      </div>
      <SectionImagePlaceholder
        src={homeLayoutImages.influencesTrailing}
        alt=""
        class="home-section-aside"
        tilt="left"
      />
    </div>
  </section>

   <div class="arena-embed">
        <iframe style="border:none;" width="100%" height="590" src="https://www.are.na/shea/shea-on-air_worldbuilding/embed" title="Gemma Copeland’s Are.na channel “Internet Explorers”"></iframe>

  </div>

      <div class="video-embed">
        <iframe
          src="https://www.youtube.com/embed/wTAaXlQGAHM?si=ZMa9ZzkQL8xKICCv&amp;controls=0"
          title="YouTube video player"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        ></iframe>
      </div>

  <div class="slogan"></div>    

  <footer class="footer">© shea on air 2026. Website by <a href="https://sheafitz.com/" target="_blank">Shea Fitzpatrick</a>.</footer>

</div>

<style>
  .home-section {
    position: relative;
    z-index: 1;
  }

  .home-section + .home-section {
    margin-top: 2.5rem;
  }

  .shows-section {
    width: 100%;
  }

  .influences-section {
    margin-bottom: 3rem;
  }

  .section-heading {
    margin: 0 0 1rem;
    font-size: 2rem;
    font-weight: inherit;
    margin-top: 5rem;
  }

  .home-spacer {
    min-height: clamp(12rem, 40vh, 24rem);
  }

  @media (min-width: 48rem) {
    .home-spacer {
      min-height: clamp(16rem, 48vh, 32rem);
    }
  }

  .releases-section {
    width: 100%;
    scroll-margin-top: var(--site-header-offset);
  }

  .releases-section-content {
    min-width: 0;
  }

  .releases-section .section-heading {
    margin-top: 0;
  }

  .info {
    max-width: 25rem;
    margin-inline: 0;
    text-align: left;
  }

  .info a {
    color: inherit;
    text-decoration: none;
  }

  .stream-list {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 16px;
    margin: 1rem 0;
  }

  .stream-link {
    color: inherit;
    text-decoration: none;
    line-height: 0;
  }

  .stream-link img {
    display: block;
    width: 32px;
    height: 32px;
  }

  .stream-link:hover,
  .stream-link:focus-visible {
    opacity: 0.75;
  }

  .contact-list {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }

  .contact-link > a {
    color: var(--text);
    text-decoration: none;
  }

  .ig {
    margin-left: 2rem;
  }

  .email {
    margin-left: 5rem;
  }

.arena {
  margin-left: 10rem;
}

  .slogan {
    font-family: BatangChe;
    text-transform: uppercase;
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 0;
    pointer-events: none;
    white-space: nowrap;
    width: max-content;
    max-width: calc(100vw - 2rem);
    background: linear-gradient(
      to bottom right,
      #03122f 0%,
      #1a4a7a 38%,
      #9ebee0 72%,
      #edf4fb 100%
    );
    opacity: 50%;
    letter-spacing: .25rem;
    background-size: 100vw 100vh;
    background-size: 100vw 100dvh;
    background-attachment: scroll;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    mix-blend-mode: multiply;
    filter: blur(.5px);
    justify-content: center;
    text-align: center;
  }

  .influences-layout {
    max-width: 100%;
    min-width: 0;
  }

  .playlist-embed {
    opacity: 70%;
    margin-bottom: 2rem;
    width: 100%;
    min-width: 0;
  }

  .playlist-embed > iframe {
    display: block;
    width: 100%;
    border: .5px solid var(--color-accent);
  }

  @media (max-width: 47.99rem) {
    .slogan {
      font-size: clamp(0.6rem, 4.6vw, 1rem);
      letter-spacing: 0.1rem;
    }

    .ig {
    margin-left: 0rem;
  }

  .email {
    margin-left: 0rem;
  }

.arena {
  margin-left: 0rem;
}
  }

  .footer {
    font-size: .75rem;
    width: 100%;
    justify-content: center;
    text-align: center;
  }

  .footer a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .video-embed {
    width: 100%;
    max-width: 35rem;
    aspect-ratio: 16 / 9;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 8rem;
  }

  .video-embed iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }


  .bio {
    font-family: BatangChe;
    font-style: italic;
    }

    .bio span {
      border: .5px solid var(--color-accent);
      border-radius: 1000%;
      padding: 4px 8px 6px;
      white-space: nowrap;
    }

    .arena-embed {
      width: 100%;
      margin-left: auto;
      margin-right: auto;
      margin-bottom: 5rem;
    }
</style>
