---
import ReleasesSection from './ReleasesSection.astro';
import ShowsAndFeaturesSection from './ShowsAndFeaturesSection.astro';
import InfluencesSection from './InfluencesSection.astro';
---

<div class="home-content">
  <section class="home-section info">
    <p>shea on air is the solo flute project of flutist, drummer, producer, and designer Shea Fitzpatrick.</p>
    <div class="stream-list">
      <a class="stream-link" href="https://sheaonair.bandcamp.com/" target="_blank">
        <img src="/images/icons/bandcamp.svg" alt="Bandcamp" />
      </a>
      <a class="stream-link" href="https://open.spotify.com/artist/26Ihw2k2n71sPltSmJiH5J?si=TEYJ8VQ5QbikWTFt7k7XQA" target="_blank">
        <img src="/images/icons/spotify.svg" alt="Spotify" />
      </a>
      <a class="stream-link" href="https://music.apple.com/us/artist/shea-on-air/1828082723" target="_blank">
        <img src="/images/icons/apple-music.svg" alt="Apple Music" />
      </a>
      <a class="stream-link" href="https://www.subvert.fm/shea-on-air" target="_blank">
        <img src="/images/icons/subvert.svg" alt="Subvert" />
      </a>
      <a class="stream-link" href="https://www.youtube.com/@sheaonairr" target="_blank">
        <img src="/images/icons/youtube.svg" alt="YouTube" />
      </a>
    </div>
    <div class="contact-list">
      <div class="contact-link"><a href="https://www.instagram.com/sheafitz/" target="_blank">@sheafitz</a></div>
      <div class="contact-link"><a href="mailto:sheaonair@gmail.com">sheaonair@gmail.com</a></div>
      <div class="contact-link"><a href="https://www.are.na/shea/" target="_blank">are.na/shea</a></div>
    </div>
  </section>

  <section class="home-section releases-section" id="releases">
    <h2 class="section-heading">Releases</h2>
    <ReleasesSection />
  </section>

  <section class="home-section shows-section">
    <h2 class="section-heading">Shows and features</h2>
    <ShowsAndFeaturesSection />
  </section>

  <section class="home-section influences-section">
    <h2 class="section-heading">Influences</h2>
    <InfluencesSection />
  </section>

  <div class="slogan">Boom Clap Tweet Tweet</div>
</div>

<style>
  .home-content {
    --release-gap: clamp(0.75rem, 2vw, 1.5rem);
    --release-cols: 1;
  }

  @media (min-width: 30rem) {
    .home-content {
      --release-cols: 2;
    }
  }

  @media (min-width: 48rem) {
    .home-content {
      --release-cols: 3;
    }
  }

  @media (min-width: 64rem) {
    .home-content {
      --release-cols: 4;
    }
  }

  .home-section {
    position: relative;
    z-index: 1;
  }

  .home-section + .home-section {
    margin-top: 2.5rem;
  }

  .shows-section {
    width: min(100%, 72rem);
  }

  .section-heading {
    margin: 0 0 1rem;
    font-size: 2rem;
    font-weight: inherit;
    margin-top: 5rem;
  }

  .info {
    max-width: 25rem;
  }

  .releases-section {
    width: min(100%, 72rem);
    padding-top: 20%;
  }

  .stream-list {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 2rem 0;
  }

  .stream-link {
    color: inherit;
    text-decoration: none;
    line-height: 0;
  }

  .stream-link img {
    display: block;
    width: 32px;
    height: 32px;
  }

  .stream-link:hover,
  .stream-link:focus-visible {
    opacity: 0.75;
  }

  .contact-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .contact-link > a {
    color: var(--text);
    text-decoration: none;
  }

  .slogan {
    font-family: BatangChe;
    text-transform: uppercase;
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 0;
    pointer-events: none;
    white-space: nowrap;
    width: max-content;
    max-width: calc(100vw - 2rem);
    background: linear-gradient(
      to bottom right,
      #03122f 0%,
      #1a4a7a 38%,
      #9ebee0 72%,
      #edf4fb 100%
    );
    opacity: 50%;
    letter-spacing: .25rem;
    background-size: 100vw 100vh;
    background-attachment: fixed;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    mix-blend-mode: multiply;
    filter: blur(.5px);
    text-align: center;
  }

  @media (max-width: 47.99rem) {
    .slogan {
      font-size: clamp(0.6rem, 4.6vw, 1rem);
      letter-spacing: 0.1rem;
    }
  }
</style>
