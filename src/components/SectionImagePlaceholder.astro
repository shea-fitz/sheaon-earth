---
interface Props {
  src?: string;
  alt?: string;
  class?: string;
  tilt?: 'left' | 'right';
}

const { src, alt = '', class: className, tilt } = Astro.props;
---

<div class:list={['section-image-placeholder', className]}>
  {src && (
    <div class="section-image-placeholder__blend" data-section-parallax>
      <img
        class:list={[
          'section-image-placeholder__img',
          tilt === 'left' && 'section-image-placeholder__img--tilt-left',
          tilt === 'right' && 'section-image-placeholder__img--tilt-right',
        ]}
        src={src}
        alt={alt}
        width="350"
        height="350"
        loading="lazy"
      />
    </div>
  )}
</div>

<style>
  .section-image-placeholder {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .section-image-placeholder__blend {
    position: absolute;
    inset: 12.5%;
    transform: translateY(var(--parallax-y, 0px));
    mix-blend-mode: screen;
    will-change: transform;
  }

  .section-image-placeholder__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: blur(.75px);
    opacity: 0.6;
    transform-origin: center;
  }

  .section-image-placeholder__img--tilt-left {
    transform: rotate(-5deg);
  }

  .section-image-placeholder__img--tilt-right {
    transform: rotate(4deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .section-image-placeholder__blend {
      --parallax-y: 0px;
      will-change: auto;
    }
  }
</style>
