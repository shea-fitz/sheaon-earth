---
interface Props {
  entries: Array<{
    slug: string;
    data: {
      title: string;
      date: Date;
      tags: string[];
    };
  }>;
}

const { entries } = Astro.props;
---

{entries.length === 0 ? (
  <p class="notes-list-empty">No notes yet.</p>
) : (
  <ul class="notes-list">
    {entries.map((entry) => {
      const isoDate = entry.data.date.toISOString().slice(0, 10);
      return (
        <li>
          <a href={`/notes/${entry.slug}/`} class="notes-list-item">
            <time class="notes-list-date" datetime={isoDate}>{isoDate}</time>
            <span class="notes-list-title-row">
              <span class="notes-list-title">{entry.data.title}</span>
              {entry.data.tags.length > 0 && (
                <span class="notes-list-tags" aria-label="Tags">
                  {entry.data.tags.map((tag) => (
                    <span class="notes-list-tag">{tag}</span>
                  ))}
                </span>
              )}
            </span>
          </a>
        </li>
      );
    })}
  </ul>
)}

<style>
  .notes-list-empty {
    margin: 0;
    padding: 0.75rem;
  }

  .notes-list {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
  }

  @media (min-width: 48rem) {
    .notes-list {
      margin-top: var(--site-header-offset);
    }
  }

  .notes-list-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.75rem;
    text-decoration: none;
    color: inherit;
    background: var(--color-surface);
    backdrop-filter: blur(5px);
    border-bottom: .5px solid color-mix(in srgb, var(--color-accent) 35%, transparent);
    transition: background 0.2s ease;
  }

  .notes-list-item:first-child {
    border-top: 1px solid color-mix(in srgb, var(--color-accent) 35%, transparent);
  }

  .notes-list-item:hover,
  .notes-list-item:focus-visible {
    background: color-mix(in srgb, var(--color-accent) 20%, transparent);
    backdrop-filter: blur(5px);
    outline: none;
  }

  .notes-list-date {
    font-family: var(--font-family-sans);
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-muted);
  }

  .notes-list-title {
    font-family: var(--font-family-batangche);
    font-size: 2rem;
    min-width: 0;
  }

  .notes-list-tags {
    display: none;
  }

  @media (min-width: 48rem) {
    .notes-list-title-row {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1.5rem;
    }

    .notes-list-tags {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 0.5rem;
      flex-shrink: 0;
      max-width: 45%;
    }

    .notes-list-tag {
      display: inline-block;
      font-family: var(--font-family-sans);
      font-size: var(--font-size-xs);
      line-height: 1.25;
      padding: 0.35rem 0.65rem;
      border: 1px solid color-mix(in srgb, var(--color-accent) 50%, transparent);
      background: color-mix(in srgb, var(--color-accent) 12%, transparent);
      white-space: nowrap;
    }
  }

  @media (max-width: 768px) {
    .notes-list-item {
      padding: 0.75rem;
      line-height: 1.15;
    }

    .notes-list-date {
      font-size: .875rem;
    }

    .notes-list-title {
      font-size: 1.5rem;
    }
  }
</style>
