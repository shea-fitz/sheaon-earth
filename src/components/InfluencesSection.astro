---
import { influences } from '../data/influences.js';

const categories = [
  { key: 'musicians', label: 'Musicians' },
  { key: 'films', label: 'Films' },
  { key: 'writers', label: 'Writers' },
  { key: 'artists', label: 'Artists' },
  { key: 'phenomena', label: 'Phenomena' },
];
---

<div class="influences-grid">
  {categories.map(({ key, label }) => (
    <div class="influence-group">
      <h3 class="influence-label">{label}</h3>
      <ul class="influence-list">
        {influences[key].map((name) => (
          <li>{name}</li>
        ))}
      </ul>
    </div>
  ))}
</div>

<style>
  .influences-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .influence-group {
    flex: 1 1 8rem;
    min-width: 0;
  }

  @media (min-width: 48rem) {
    .influences-grid {
      flex-wrap: nowrap;
    }

    .influence-group {
      flex: 0 0 auto;
      max-width: 250px;
    }
  }

  .influence-label {
    margin: 0 0 0.5rem;
    font-size: inherit;
    font-weight: inherit;
    color: var(--color-accent);
  }

  .influence-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
</style>
