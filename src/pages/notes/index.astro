---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const entries = (await getCollection('notes')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Base title="Notes — shea on air" background="bg3">
  {entries.length === 0 ? (
    <p>No notes yet.</p>
  ) : (
    <ul>
      {entries.map((entry) => (
        <li>
          <a href={`/notes/${entry.slug}/`}>{entry.data.title}</a>
          {entry.data.description && <p>{entry.data.description}</p>}
        </li>
      ))}
    </ul>
  )}
</Base>
