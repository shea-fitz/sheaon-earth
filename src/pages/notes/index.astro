---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NotesList from '../../components/NotesList.astro';
import { getListedNotes } from '../../utils/notes.js';

const entries = getListedNotes(await getCollection('notes')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Base title="shea on air: notes" background="bg3" flushTop>
  <div class="centered-page-content">
    <NotesList entries={entries} />
  </div>
</Base>
