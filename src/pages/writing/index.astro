---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const entries = (await getCollection('writing')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Base title="Writing — shea on air">
  <h1>Writing</h1>

  {entries.length === 0 ? (
    <p>No writing entries yet.</p>
  ) : (
    <ul>
      {entries.map((entry) => (
        <li>
          <a href={`/writing/${entry.slug}/`}>{entry.data.title}</a>
          {entry.data.description && <p>{entry.data.description}</p>}
        </li>
      ))}
    </ul>
  )}
</Base>
